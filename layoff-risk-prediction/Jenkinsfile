pipeline {
    agent any

    environment {
        DOCKER_USER = 'vishruthere'
        VERSION = "${BUILD_NUMBER}"          // Fixed: was "v${BUILD_NUMBER}"
        PROJECT_DIR = 'layoff-risk-prediction'
    }

    stages {

        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Setup Environment') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        pwd
                        ls -la

                        python3 -m venv venv || true
                        . venv/bin/activate

                        python -m pip install --upgrade pip
                        pip install -r requirements-ci.txt
                    '''
                }
            }
        }

        stage('3. Retrain Model') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        . venv/bin/activate

                        export TF_CPP_MIN_LOG_LEVEL=3
                        export CUDA_VISIBLE_DEVICES=""
                        export OMP_NUM_THREADS=2

                        python scripts/retrain_pipeline.py \
                          --data mlops-dataset-layoff-risk/tech_layoffs_2025_2026.csv \
                          --models-dir models
                    '''
                }
            }
        }

        stage('4. Validate Metrics') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        echo "Checking model quality metrics..."

                        sh '''
                            if [ -f "models/model_schema.json" ]; then
                                echo "✅ Metrics validated."
                            else
                                echo "❌ model_schema.json missing"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }

        stage('5. Run Unit Tests') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        echo "Running Backend Unit Tests..."

                        sh '''
                            . venv/bin/activate
                            export PYTHONPATH=$PYTHONPATH:$(pwd)/backend
                            python -c "print('✅ Python environment OK')"
                        '''
                    }
                }
            }
        }

        stage('6. Build Docker Images') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        echo "Building images with Version: v${VERSION}"

                        sh """
                            docker build \
                            -t ${DOCKER_USER}/careershield-backend:v${VERSION} \
                            -t ${DOCKER_USER}/careershield-backend:latest \
                            -f backend/Dockerfile .
                        """

                        sh """
                            docker build \
                            -t ${DOCKER_USER}/careershield-frontend:v${VERSION} \
                            -t ${DOCKER_USER}/careershield-frontend:latest \
                            -f frontend/Dockerfile ./frontend
                        """
                    }
                }
            }
        }

        stage('7. Push Docker Images') {
            steps {
                dir("${PROJECT_DIR}") {                    // Added: was missing
                    script {
                        echo "Pushing Version v${VERSION} to Docker Hub..."
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-hub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh '''
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker push ${DOCKER_USER}/careershield-backend:v${VERSION}
                                docker push ${DOCKER_USER}/careershield-frontend:v${VERSION}
                            '''
                        }
                    }
                }
            }
        }

        stage('8. Deploy Application') {
            steps {
                dir("${PROJECT_DIR}") {
                    echo "Deploying newly built containers..."
                    sh 'docker-compose up -d'
                }
            }
        }

        stage('9. Health Check') {
            steps {
                script {
                    echo "Waiting for API endpoint to respond..."

                    sh '''
                        count=0

                        until $(curl --output /dev/null --silent --fail http://localhost:8000/health); do
                            if [ $count -eq 12 ]; then
                                echo "❌ Health check failed"
                                exit 1
                            fi

                            sleep 5
                            count=$((count+1))
                        done

                        echo "✅ Health check passed"
                    '''
                }
            }
        }

        stage('10. Smoke Test') {
            steps {
                script {
                    echo "Verifying AI Inference API..."

                    sh '''
                        RESPONSE=$(curl -s -X POST "http://localhost:8000/predict" \
                          -H "Content-Type: application/json" \
                          -d '{"industry":"Software","department":"Engineering","ai_exposure":"Partial","total_employees":5000}')

                        echo "$RESPONSE"

                        if echo "$RESPONSE" | grep -q "risk_probability"; then
                            echo "✅ Smoke Test Passed!"
                        else
                            echo "❌ Smoke Test Failed"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('11. Cleanup') {
            steps {
                echo "Cleaning up dangling images..."
                sh 'docker image prune -f'
            }
        }

        stage('12. Final Status') {
            steps {
                echo "🚀 Deployment of v${VERSION} is LIVE and verified!"
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully for v${VERSION}"
        }
        failure {
            echo "❌ Pipeline failed at version v${VERSION}. Check logs for rollback instructions."
        }
    }
}
